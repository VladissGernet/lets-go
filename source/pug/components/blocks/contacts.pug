mixin contacts(modClass="")
  ul.contacts(class=modClass)
    li.contacts__item
      a.contacts__link(href="tel:88005558628")
        span.visually-hidden Телефон
        span.contacts__icon.contacts__icon--desktop
          +icon("phone", 18, 18)
        span.contacts__icon.contacts__icon--mobile
          +icon("phone-2", 17, 15)
        span.contacts__text
          | 8&nbsp;800 555-86-28
    li.contacts__item
      a.contacts__link(href="mailto:mail@htmlacademy.ru")
        span.visually-hidden E-mail
        span.contacts__icon.contacts__icon--desktop
          +icon("mail", 16, 14)
        span.contacts__icon.contacts__icon--mobile
          +icon("mail-2", 19, 13)
        span.contacts__text
          | mail@htmlacademy.ru
