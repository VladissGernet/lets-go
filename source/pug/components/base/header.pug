-
  const menuItems = {
    "о сервисе": "#",
    "направления": "#",
    "попутчики": "#"
  }

-
  const menuContacts = [
    {
      icon: "phone",
      iconWidth: 18,
      iconHeight: 18,
      href: "tel:88005558628",
    },
    {
      icon: "mail",
      iconWidth: 16,
      iconHeight: 14,
      href: "mailto:mail@htmlacademy.ru",
    }
  ]

mixin header(headerMods, currentUrl)
  header.header(class=headerMods, data-header)
    .container
      //- Логотип
      if(currentUrl === "index.html")
        //- lighthouse снимает 10 баллов SEO за <a> без href, поэтому использую <span>
        span.header__logo
          img(src="img/svg/logo-light.svg", width="200", height="50", alt="Логотип проекта Пакет X5.")
          +icon("logo-mobile", 96, 15)
      else
        a.header__logo(href="index.html", aria-label="Переход на главную")
          img(src="img/svg/logo-light.svg", width="200", height="50", alt="Логотип проекта Пакет X5.")
          +icon("logo-mobile", 96, 15)
      nav.header__nav
        //- Меню навигации
        ul.header__list
          each menuLink, menuItem in menuItems
            li.header__item
              +link({text: menuItem, href: menuLink}).header__link
        +contacts(menuContacts)
      button(class="header__toggle", type="button", data-burger)
        +icon("burger", 25, 12).header__icon.header__icon--burger
        +icon("cross", 19, 20).header__icon.header__icon--cross
