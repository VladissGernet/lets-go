mixin profile()
  section.profile
    .container
      h2 Добавьте свой профиль
      ol.profile__list
        li.profile__item
          span Базовое размещение
        li.profile__item
          span Вывод на первых позициях
        li.profile__item
          span Кастомный цвет карточки
      .profile__price
        .profile__price-value
          span Бесплатно
        .profile__price-value
          span 99 руб./мес
        .profile__price-value
          span 59 руб./мес
        .profile__icon
          +icon("price", 200, 202)
      +btn({text: "Показать тарифы для бизнеса"})(data-open-modal="feedback").profile__button
