mixin social(socialMods)
  ul.social(class=socialMods)
    li.social__item
      a.social__link(href="#", aria-label="Telegram")
        +icon("telegram", 25, 25)
    li.social__item
      a.social__link(href="#", aria-label="Вконтакте")
        +icon("vk", 31, 17)
    li.social__item
      a.social__link(href="#", aria-label="Youtube")
        +icon("youtube", 21, 17)
