mixin directions()
  section.directions
    .container
      .directions__swiper
        .directions__fade.directions__fade--top
          +img("content/directions/fade", "fade-top", "png", "610", "81", "")
        .directions__fade.directions__fade--bottom
          +img("content/directions/fade", "fade-bottom", "png", "619", "81", "")
        .directions__swiper-wrapper
          .directions__slide Slide 1
          .directions__slide Slide 2
          .directions__slide Slide 3
          .directions__slide Slide 4
          .directions__slide Slide 5
          .directions__slide Slide 6
          .directions__slide Slide 7
          .directions__slide Slide 8
          .directions__slide Slide 9
