mixin directions()
  section.directions
    .container
      .directions__content
        h2 Направления
        p
          | Мы&nbsp;не&nbsp;продаем туры и&nbsp;ничего не&nbsp;рекламируем.
          br
          | Люди сами пишут о&nbsp;странах, куда хотели&nbsp;бы отправиться и&nbsp;чем можно там заняться.
        +btn({text: "Показать все", href: "#", type: "submit"}).directions__button
      .directions__swiper
        .directions__fade.directions__fade--top
          +img("content/directions/fade", "fade-top", "png", "610", "81", "")
        .directions__fade.directions__fade--bottom
          +img("content/directions/fade", "fade-bottom", "png", "619", "81", "")
        .directions__swiper-wrapper
          //- Минимум 4 слайда
          .directions__slide
            h3 Франция
            p Трэ бьен, манифик!
            .directions__status
              +icon("person-icon", 20, 20)
              span 12518
            .directions__picture
              picture
                source(media="(max-width: 767px)", srcset="img/content/directions/countries/france-mobile.png 1x, img/content/directions/countries/france-mobile@2x.png 2x", type="image/png")
                source(media="(max-width: 1023px)", srcset="img/content/directions/countries/france-tablet.png 1x, img/content/directions/countries/france-tablet@2x.png 2x", type="image/png")
                img(src="img/content/directions/countries/france-desktop.png", srcset="img/content/directions/countries/france-desktop@2x.png 2x", width="186", height="140", alt="Улица во Франции.")
            .directions__flag
              +icon("france", 70, 47)
          .directions__slide
            h3 Чехия
            p Закоулки старой Европы
            .directions__status
              +icon("person-icon", 20, 20)
              span 5326
            .directions__picture
              picture
                source(media="(max-width: 767px)", srcset="img/content/directions/countries/czech-mobile.png 1x, img/content/directions/countries/czech-mobile@2x.png 2x", type="image/png")
                source(media="(max-width: 1023px)", srcset="img/content/directions/countries/czech-tablet.png 1x, img/content/directions/countries/czech-tablet@2x.png 2x", type="image/png")
                img(src="img/content/directions/countries/czech-desktop.png", srcset="img/content/directions/countries/czech-desktop@2x.png 2x", width="201", height="140", alt="Паром на реке на фоне города в Чехии.")
            .directions__flag
              +icon("czech", 70, 47)
          .directions__slide
            h3 Таиланд
            p Джунгли зовут!
            .directions__status
              +icon("person-icon", 20, 20)
              span 18321
            .directions__picture
              picture
                source(media="(max-width: 767px)", srcset="img/content/directions/countries/thailand-mobile.png 1x, img/content/directions/countries/thailand-mobile@2x.png 2x", type="image/png")
                source(media="(max-width: 1023px)", srcset="img/content/directions/countries/thailand-tablet.png 1x, img/content/directions/countries/thailand-tablet@2x.png 2x", type="image/png")
                img(src="img/content/directions/countries/thailand-desktop.png", srcset="img/content/directions/countries/thailand-desktop@2x.png 2x", width="201", height="140", alt="Вид с вершины горы вниз на песчаный пляж в Тайланде.")
            .directions__flag
              +icon("thailand", 70, 47)
          .directions__slide
            h3 Таиланд
            p Джунгли зовут!
            .directions__status
              +icon("person-icon", 20, 20)
              span 18321
            .directions__picture
              picture
                source(media="(max-width: 767px)", srcset="img/content/directions/countries/thailand-mobile.png 1x, img/content/directions/countries/thailand-mobile@2x.png 2x", type="image/png")
                source(media="(max-width: 1023px)", srcset="img/content/directions/countries/thailand-tablet.png 1x, img/content/directions/countries/thailand-tablet@2x.png 2x", type="image/png")
                img(src="img/content/directions/countries/thailand-desktop.png", srcset="img/content/directions/countries/thailand-desktop@2x.png 2x", width="201", height="140", alt="Вид с вершины горы вниз на песчаный пляж в Тайланде.")
            .directions__flag
              +icon("thailand", 70, 47)
