mixin cards-filter(cardsFilterMods)
  section.cards-filter(data-tabs="element", class=cardsFilterMods)
    h2 Подберите идеального  попутчика
    form(method="post", enctype="multipart/form-data", action="#", autocomplete="off")
      .accordion(data-accordion="parent")
        .accordion__element(data-accordion="element")
          button.accordion__button.cards-filter__accordion-button(type="button", data-accordion="button")
            span Хобби
            span.cards-filter__accordion-button-icon
              +icon("accordion-arrow", 10, 6)
          .accordion__content(data-accordion="content")
            .accordion__wrapper
              +custom-toggle({
                inputLabel: "Спортзал",
                inputName: "filter-hobby",
                inputValue: "filter-hobby-1",
                inputChecked: true
              }).custom-toggle--checkbox
              +custom-toggle({
                inputLabel: "Кальян",
                inputName: "filter-hobby",
                inputValue: "filter-hobby-2",
                inputChecked: false
              }).custom-toggle--checkbox
              +custom-toggle({
                inputLabel: "Диван",
                inputName: "filter-hobby",
                inputValue: "filter-hobby-3",
                inputChecked: false
              }).custom-toggle--checkbox
        .accordion__element.is-active(data-accordion="element")
          button.accordion__button.cards-filter__accordion-button(type="button", data-accordion="button")
            span Музыка
            span.cards-filter__accordion-button-icon
              +icon("accordion-arrow", 10, 6)
          .accordion__content(data-accordion="content")
            .accordion__wrapper
              +custom-toggle({
                inputLabel: "Тяжелый рок",
                inputName: "filter-music",
                inputValue: "filter-music-1",
                inputChecked: true
              }).custom-toggle--checkbox
              +custom-toggle({
                inputLabel: "Русский рэп",
                inputName: "filter-music",
                inputValue: "filter-music-2",
                inputChecked: false
              }).custom-toggle--checkbox
              +custom-toggle({
                inputLabel: "Евроденс",
                inputName: "filter-music",
                inputValue: "filter-music-3",
                inputChecked: false
              }).custom-toggle--checkbox
        .accordion__element(data-accordion="element")
          button.accordion__button.cards-filter__accordion-button(type="button", data-accordion="button")
            span Еда
            span.cards-filter__accordion-button-icon
              +icon("accordion-arrow", 10, 6)
          .accordion__content(data-accordion="content")
            .accordion__wrapper
              +custom-toggle({
                inputLabel: "Мясоед",
                inputName: "filter-food",
                inputValue: "filter-food-1",
                inputChecked: true
              }).custom-toggle--checkbox
              +custom-toggle({
                inputLabel: "Сидит на ПП",
                inputName: "filter-food",
                inputValue: "filter-food-2",
                inputChecked: false
              }).custom-toggle--checkbox
              +custom-toggle({
                inputLabel: "Веган-сыроед",
                inputName: "filter-food",
                inputValue: "filter-food-3",
                inputChecked: false
              }).custom-toggle--checkbox
        .accordion__element.is-active(data-accordion="element")
          button.accordion__button.cards-filter__accordion-button(type="button", data-accordion="button")
            span Транспорт
            span.cards-filter__accordion-button-icon
              +icon("accordion-arrow", 10, 6)
          .accordion__content(data-accordion="content")
            .accordion__wrapper.cards-filter__special-checkboxes
              .custom-toggle.custom-toggle--special-checkbox
                label
                  input(type="checkbox", value="filter-transport-1", name="filter-transport", checked="checked")
                  span.custom-toggle__icon
                    +icon("aircraft", 23, 22)
                  span.custom-toggle__label.visually-hidden Самолет
              .custom-toggle.custom-toggle--special-checkbox
                label
                  input(type="checkbox", value="filter-transport-2", name="filter-transport", checked="checked")
                  span.custom-toggle__icon
                    +icon("bus", 23, 22)
                  span.custom-toggle__label.visually-hidden Автобус
              .custom-toggle.custom-toggle--special-checkbox
                label
                  input(type="checkbox", value="filter-transport-3", name="filter-transport")
                  span.custom-toggle__icon
                    +icon("bicycle", 23, 22)
                  span.custom-toggle__label.visually-hidden Велосипед
              .custom-toggle.custom-toggle--special-checkbox
                label
                  input(type="checkbox", value="filter-transport-4", name="filter-transport", checked="checked")
                  span.custom-toggle__icon
                    +icon("run", 23, 22)
                  span.custom-toggle__label.visually-hidden Бегун
        .accordion__element.accordion__element--slider.is-active(data-accordion="element")
          button.accordion__button.cards-filter__accordion-button(type="button", data-accordion="button")
            span Левел
            span.cards-filter__accordion-button-icon
              +icon("accordion-arrow", 10, 6)
          .accordion__content(data-accordion="content")
            .accordion__wrapper.accordion__wrapper--slider
              .cards-filter__slider-inputs
                +custom-input({
                  inputName: "user-level-from",
                })
                +custom-input({
                  inputName: "user-level-to",
                })
              .cards-filter__slider-wrapper
                .cards-filter__slider(id="slider")
      +btn({text: "Показать", type: "submit"}).btn--tertiary.cards-filter__button
