mixin profile-modal()
  h2 Бизнес-тарифы
  dl.profile-modal__list
    .profile-modal__item
      dt Реклама у блоггера
      dd 300 000 руб./пост
    .profile-modal__item
      dt Накрутка подписчиков
      dd от 1 руб./шт.
    .profile-modal__item
      dt Лайки от ботов
      dd от 20 коп./лайк
    .profile-modal__item
      dt Ваш продакт-плейсмент
      dd Индивидуально
