mixin hero()
  section.hero
    .hero__background
      picture
        source(media="(max-width: 1023px)", srcset="img/content/hero/globe-back-tablet.jpg 1x, img/hero/globe-back-tablet@2x.jpg 2x", type="image/jpg")
        img(src="img/content/hero/globe-back-desktop.png", srcset="img/hero/globe-back-desktop@2x.png 2x", width="1440", height="750", alt="")
    .hero__picture
      picture
        source(media="(max-width: 767px)", srcset="img/content/hero/traveller-mobile.png 1x, img/hero/traveller-mobile@2x.png 2x", type="image/png")
        source(media="(max-width: 1023px)", srcset="img/content/hero/traveller-tablet.png 1x, img/hero/traveller-tablet@2x.png 2x", type="image/png")
        img(src="img/content/hero/traveller-desktop.png", srcset="img/hero/traveller-desktop@2x.png 2x", width="431", height="640", alt="")
    .container
      h2
        | В&nbsp;путешествие
        | с&nbsp;крутыми
        | попутчиками
        span !
      ol.hero__list
        li.hero__item.hero__item--1
          p Выберите направление
        li.hero__item.hero__item--2
          p Изучите идеи путешественников
        li.hero__item.hero__item--3
          p Находите тех, кто&nbsp;похож на&nbsp;вас
        li.hero__item.hero__item--4
          p Путешествуйте вместе!
