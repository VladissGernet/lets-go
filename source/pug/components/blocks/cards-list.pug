mixin cards-list(cardsListMods)
  ul.cards-list.companions(class=cardsListMods)
    li.companions__profile.companions__profile--99
      ul.companions__flags
        li.companions__flag
          +icon("sri-lanka", 35, 24)
          span шри-ланка
        li.companions__flag
          +icon("thailand", 35, 24)
          span Таиланд
        li.companions__flag
          +icon("seychelles", 35, 24)
          span Сейшелы
      h3
        span Таня Фирсова
      p
        | #ЗОЖ #ПП #Фитнес #пляж
        | #авокадо #смузи
      .companions__progress
        .companions__progress-value
          span 99
        .companions__progress-level
          span level
        svg.companions__progress-icon(viewBox="0 0 36 36")
          circle.companions__progress-circle(cx="18", cy="18", r="18", stroke="#4d99d6", fill="none", stroke-width="3", stroke-dasharray="10", stroke-dashoffset="50")
      .companions__avatar
        picture
          source(media="(max-width: 1023px)", srcset="img/content/filter-cards/firsova-tablet.png 1x, img/content/filter-cards/firsova-tablet@2x.png 2x", type="image/png")
          img(src="img/content/filter-cards/firsova-desktop.png", srcset="img/content/filter-cards/firsova-desktop@2x.png 2x", width="285", height="285", alt="Таня Фирсова.")
      ul.companions__styles
        li.companions__style
          +icon("aircraft", 35, 24)
        li.companions__style.companions__style--disabled
          +icon("bus", 35, 24)
        li.companions__style.companions__style--disabled
          +icon("bicycle", 35, 24)
        li.companions__style.companions__style--disabled
          +icon("run", 35, 24)
    li.companions__profile.companions__profile--80
      ul.companions__flags
        li.companions__flag
          +icon("belgium", 35, 24)
          span Бельгия
        li.companions__flag
          +icon("czechia", 35, 24)
          span Чехия
      h3
        span Петя Демин
      p
          | #бургер #бар #футбол
          | #концерт #крафт
      .companions__progress
        .companions__progress-value
          span 80
        .companions__progress-level
          span level
        svg.companions__progress-icon(viewBox="0 0 36 36")
          circle.companions__progress-circle(cx="18", cy="18", r="18", stroke="#4d99d6", fill="none", stroke-width="3", stroke-dasharray="10", stroke-dashoffset="50")
      .companions__avatar
        picture
          source(media="(max-width: 1023px)", srcset="img/content/filter-cards/demin-tablet.png 1x, img/content/filter-cards/demin-tablet@2x.png 2x", type="image/png")
          img(src="img/content/filter-cards/demin-desktop.png", srcset="img/content/filter-cards/demin-desktop@2x.png 2x", width="285", height="285", alt="Петя Демин.")
      ul.companions__styles
        li.companions__style
          +icon("aircraft", 35, 24)
        li.companions__style
          +icon("bus", 35, 24)
        li.companions__style.companions__style--disabled
          +icon("bicycle", 35, 24)
        li.companions__style
          +icon("run", 35, 24)
      .companions__buttons-wrapper
        +btn({text: "Позвать!", type: "button"}).btn--quaternary.companions__call-button
        +like-btn("1500").companions__like-button
    li.companions__profile.companions__profile--25
      ul.companions__flags
        li.companions__flag
          +icon("usa", 35, 24)
          span США
        li.companions__flag
          +icon("australia", 35, 24)
          span Австралия
        li.companions__flag
          +icon("dominicana", 35, 24)
          span Доминикана
      h3
        span Марк Смолов
      p
        | #рэп #тату #хайпбист
        | #кроссовки #суприм
      .companions__progress
        .companions__progress-value
          span 25
        .companions__progress-level
          span level
        svg.companions__progress-icon(viewBox="0 0 36 36")
          circle.companions__progress-circle(cx="18", cy="18", r="18", stroke="#4d99d6", fill="none", stroke-width="3", stroke-dasharray="10", stroke-dashoffset="50")
      .companions__avatar
        picture
          source(media="(max-width: 1023px)", srcset="img/content/filter-cards/smolov-tablet.png 1x, img/content/filter-cards/smolov-tablet@2x.png 2x", type="image/png")
          img(src="img/content/filter-cards/smolov-desktop.png", srcset="img/content/filter-cards/smolov-desktop@2x.png 2x", width="285", height="285", alt="Петя Демин.")
      ul.companions__styles
        li.companions__style
          +icon("aircraft", 35, 24)
        li.companions__style.companions__style--disabled
          +icon("bus", 35, 24)
        li.companions__style
          +icon("bicycle", 35, 24)
        li.companions__style.companions__style--disabled
          +icon("run", 35, 24)
      .companions__buttons-wrapper
        +btn({text: "Позвать!", type: "button"}).btn--quaternary.companions__call-button
        +like-btn("170").companions__like-button
    li.companions__profile.companions__profile--online.companions__profile--50
      ul.companions__flags
        li.companions__flag
          +icon("great-britan", 35, 24)
          span Великобритания
        li.companions__flag
          +icon("germany", 35, 24)
          span Германия
      h3
        span Лариса Роговая
      p
        | #образование #карьера
        | #учеба #линкедин
      .companions__progress
        .companions__progress-value
          span 50
        .companions__progress-level
          span level
        svg.companions__progress-icon(viewBox="0 0 36 36")
          circle.companions__progress-circle(cx="18", cy="18", r="18", stroke="#4d99d6", fill="none", stroke-width="3", stroke-dasharray="10", stroke-dashoffset="50")
      .companions__avatar
        picture
          source(media="(max-width: 1023px)", srcset="img/content/filter-cards/rogovaya-tablet.png 1x, img/content/filter-cards/rogovaya-tablet@2x.png 2x", type="image/png")
          img(src="img/content/filter-cards/rogovaya-desktop.png", srcset="img/content/filter-cards/rogovaya-desktop@2x.png 2x", width="285", height="285", alt="Петя Демин.")
      ul.companions__styles
        li.companions__style
          +icon("aircraft", 35, 24)
        li.companions__style
          +icon("bus", 35, 24)
        li.companions__style.companions__style--disabled
          +icon("bicycle", 35, 24)
        li.companions__style.companions__style--disabled
          +icon("run", 35, 24)
      .companions__buttons-wrapper
        +btn({text: "Позвать!", type: "button"}).btn--quaternary.companions__call-button
        +like-btn("23").companions__like-button
