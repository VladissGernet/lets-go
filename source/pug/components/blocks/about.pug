mixin about()
  section.about
    .container
      .about__content
        h2 О&nbsp;сервисе
        .about__description
          p
            | Любое путешествие веселее с&nbsp;попутчиками, которые
            | на&nbsp;одной волне с&nbsp;тобой! Делитесь своими идеями
            | путешествий и&nbsp;черпайте вдохновение в&nbsp;чужих.
        .about__additional
          p
            | А&nbsp;если найдете кого-то близкого по&nbsp;духу&nbsp;- скорее
            br
            | зовите в&nbsp;совместный трип!
      .about__background(data-speed="0.18")
        picture
          source(media="(max-width: 767px)", srcset="img/content/about/about-back-mobile.png 1x, img/content/about/about-back-mobile@2x.png 2x", type="image/png")
          source(media="(max-width: 1023px)", srcset="img/content/about/about-back-tablet.png 1x, img/content/about/about-back-tablet@2x.png 2x", type="image/png")
          img(src="img/content/about/about-back-desktop.png", srcset="img/content/about/about-back-desktop@2x.png 2x", width="655", height="665", alt="Скриншот страницы сервиса.")
