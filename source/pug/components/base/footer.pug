mixin logoFooterContent()
  span.footer__logo-icon.footer__logo-icon--desktop
    +icon("logo-tablet", 200, 50)(aria-label="Логотип проекта Пакет X5.")
  span.footer__logo-icon.footer__logo-icon--tablet
    img(src="img/svg/logo.svg", width="200", height="50", alt="Логотип проекта Пакет X5.")
  span.footer__logo-icon.footer__logo-icon--mobile
    +icon("logo-mobile", 96, 15)(aria-label="Логотип проекта Пакет X5.")

mixin footer(footerMods, currentUrl)
  footer.footer(class=footerMods)
    .container
      //- Логотип
      if(currentUrl === "index.html")
        //- lighthouse снимает 10 баллов SEO за <a> без href, поэтому использую <span>
        span.header__logo
          +logoFooterContent()
      else
        a.header__logo(href="index.html", aria-label="Переход на главную")
          +logoFooterContent()
      +social("footer__social")
